---
import Layout from '../components/Layout.astro';
import WorkPreview from '../components/WorkPreview.astro';
import { ArrowUpRight, ArrowDown, ArrowRight } from 'lucide-react';
import { profile } from '../data/profile';
import { professionalCases } from '../data/v23';
import { publicImpactClaims } from '../data/impactClaims';
const impact = ['backlog', 'closure', 'p4p'].map(id => publicImpactClaims.find(claim => claim.id === id)).filter(Boolean);
const workTitles = ['Claims, made actionable.', 'Better predictions. Better care.', 'From models to a product.', 'Private data. Useful answers.'];
const workCategories = ['Agentic AI / Insurance', 'Predictive ML / Healthcare', 'Product engineering / MLOps', 'Document intelligence / Local AI'];
---
<Layout title="Shailesh Dudala — Senior Applied AI / ML Engineer" description="Applied AI and ML engineering across healthcare and insurance. Explore Shailesh Dudala's professional work, open-source projects, and research." canonicalPath="/">
  <section class="folio-hero shell" aria-labelledby="home-title">
    <div class="folio-eyebrow"><p>Senior Applied AI / ML Engineer</p><span>Healthcare &amp; insurance</span></div>
    <h1 id="home-title">Shailesh <em>Dudala.</em></h1>
    <div class="folio-intro">
      <p>I turn complex data into AI systems<br class="desktop-break"/> people can put to work.</p>
      <div><p>Production agentic AI, predictive ML, and document intelligence. Built with the care real operations demand.</p><a class="text-link" href="#selected-work">Explore selected work <ArrowDown size={17} aria-hidden="true" /></a></div>
    </div>
    <div class="folio-hero-foot"><span>From scientific computing to production AI.</span><a href={profile.linkedin}>LinkedIn <ArrowUpRight size={14} aria-hidden="true" /></a><a href={profile.github}>GitHub <ArrowUpRight size={14} aria-hidden="true" /></a></div>
  </section>

  <section class="folio-work shell" id="selected-work" aria-labelledby="work-title">
    <header class="folio-section-head"><div><span class="section-number">01 / Selected work</span><h2 id="work-title">Built around real problems.</h2></div><a class="text-link" href="/work/">All professional work <ArrowUpRight size={17} aria-hidden="true" /></a></header>
    <div class="folio-work-grid">{professionalCases.map((item, index) => <article class="folio-work-item">
      <a class="folio-work-image" href={item.href} aria-label={`Read ${item.title}`}><WorkPreview kind={item.slug} /><span class="image-open"><ArrowUpRight size={21} aria-hidden="true" /></span></a>
      <div class="folio-work-meta"><span>{workCategories[index]}</span><span>{item.number}</span></div>
      <h3><a href={item.href}>{workTitles[index]}</a></h3><p>{item.lede}</p>
      <div class="folio-work-outcome"><strong>{item.proof}</strong><ArrowUpRight size={16} aria-hidden="true" /></div>
    </article>)}</div>
  </section>

  <section class="folio-outcomes" aria-label="Selected professional outcomes"><div class="shell"><p class="section-number">Selected outcomes<br/><span>Across distinct workstreams</span></p>{impact.map(claim => claim && <article><strong>{claim.value}</strong><h2>{claim.label}</h2><p>{claim.qualification ?? claim.context}</p></article>)}</div></section>

  <section class="folio-lab shell" aria-labelledby="lab-title">
    <header class="folio-section-head"><div><span class="section-number">02 / In the open</span><h2 id="lab-title">A closer look at the engineering.</h2></div><a class="text-link" href="/lab/">Explore projects <ArrowUpRight size={17} aria-hidden="true" /></a></header>
    <div class="folio-lab-grid">
      <a class="folio-lab-project" href="/systems/llm-steering/"><div class="folio-lab-media"><img src="/assets/case-studies/llm-steering/screenshots/workbench-still.webp" alt="LLM Steering workbench showing a baseline and steered model experiment" width="1280" height="720" loading="lazy" /></div><div><span>Research workbench</span><h3>LLM Steering <ArrowUpRight size={20} aria-hidden="true" /></h3><p>Inspect, adjust, and compare model behavior.</p></div></a>
      <a class="folio-lab-project" href="/lab/alphaquant/"><div class="folio-lab-media"><img src="/assets/case-studies/alphaquant/screenshots/ui-screenshot.png" alt="AlphaQuant research interface with its workflow and research results" width="1536" height="1024" loading="lazy" /></div><div><span>Agent orchestration / Engineering demo</span><h3>AlphaQuant <ArrowUpRight size={20} aria-hidden="true" /></h3><p>Multi-agent research, from workflow to inspectable output.</p></div></a>
    </div>
  </section>

  <section class="folio-about"><div class="shell folio-about-grid"><div><span class="section-number">03 / A little context</span><h2>Research trained me to ask.<br/><em>Engineering taught me to build.</em></h2></div><div><p>My work spans biomedical informatics, healthcare analytics, private document systems, and production agentic AI. The thread through all of it: understanding the decision, then building the system that makes it possible.</p><div class="folio-about-links"><a class="text-link" href="/experience/">Experience <ArrowUpRight size={16} aria-hidden="true" /></a><a class="text-link" href="/research/">Research &amp; publications <ArrowUpRight size={16} aria-hidden="true" /></a></div><p class="folio-award">Team recipient, 2025 Global HL7 AI Challenge<br/><a href="/recognition/#lets-talk-doc">Let's Talk Doc · Transformative Impact in Healthcare <ArrowUpRight size={13} aria-hidden="true" /></a></p></div></div></section>

  <section class="folio-contact shell" id="contact"><div><span class="section-number">Have something in mind?</span><h2>Let's build something useful.</h2></div><a class="folio-contact-link" href={`mailto:${profile.email}`}>Get in touch <ArrowRight size={28} aria-hidden="true" /></a></section>
</Layout>

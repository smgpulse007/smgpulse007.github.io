---
import Layout from '../../components/Layout.astro';
import { professionalCases, selectedEngagements, capabilityCrosswalk } from '../../data/v23';
---
<Layout title="Professional Work — Shailesh Dudala" description="Deep professional case studies across production agentic claims automation, predictive healthcare ML, healthcare analytics platforms, and on-prem document intelligence." canonicalPath="/work/">
  <section class="v23-page-hero work-v23-hero"><div class="shell"><p class="v23-kicker">WORK / PROFESSIONAL SYSTEMS</p><div><h1>Selected work.</h1><p>Four professional systems across insurance, healthcare, and private AI. The problem, the engineering decisions, and what changed.</p></div></div></section>
  <section class="v23-work-index"><div class="shell v23-case-editorial">{professionalCases.map((item)=><article class={`case-editorial-item accent-${item.accent}`}><div class="case-index"><span>{item.number}</span><small>{item.eyebrow}</small></div><div class="case-copy"><h2>{item.title}</h2><p>{item.lede}</p><ol>{item.system.map((step)=><li>{step}</li>)}</ol><a href={item.href}>Read case study <span>↗</span></a></div><aside><span>DOCUMENTED CHANGE</span><strong>{item.proof}</strong><p>{item.secondaryProof}</p></aside></article>)}</div></section>
  <section class="v23-section engagements-section"><div class="shell v23-section-heading"><div><p class="v23-kicker">Selected engagements</p><h2>Beyond the flagship projects.</h2></div><p>Quality evidence, interoperability, hospital operations, and provider analytics.</p></div><div class="shell engagement-ledger">{selectedEngagements.map((item,index)=><article><span>{String(index+1).padStart(2,'0')}</span><div><small>{item.context}</small><h3>{item.title}</h3></div><strong>{item.result}</strong><p>{item.capabilities.join(' · ')}</p></article>)}</div></section>
  <section class="v23-section capability-section"><div class="shell v23-section-heading"><div><p class="v23-kicker">Capability crosswalk</p><h2>Capabilities in practice.</h2></div><p>Methods and technologies used across the professional work and public projects.</p></div><div class="shell capability-crosswalk">{capabilityCrosswalk.map((item,index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{item.capability}</h3><p>{item.proof}</p><ul>{item.surfaces.map((surface)=><li>{surface}</li>)}</ul></article>)}</div></section>
  <section class="v23-inline-contact"><div class="shell"><p>Looking for the complete chronology?</p><a href="/experience/">View experience →</a><a href="/resume/">Open the public résumé ↗</a></div></section>
</Layout>
